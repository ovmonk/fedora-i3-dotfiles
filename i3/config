################## jpy的i3配置 ###################

######## 一些开机启动之类的 ##########

# exec 和 exec_always 的运行机制有本质区别，exec（你目前用的）： 只在 i3 第一次完全启动（也就是你刚开机登录进桌面时） 执行一次。当你按下 Win+Shift+r（重启 i3 进程）时，i3 为了防止程序被重复启动导致冲突，绝对不会 再次运行带有 exec 的命令。exec_always： 无论是开机第一次启动，还是每次你按 Win+Shift+r 刷新桌面，它都会重新执行一遍。

exec_always xrdb -merge ~/.Xresources

# 在 i3 启动时，把鼠标光标从 X11 默认的那个难看的大叉形光标 ✛ 改成正常的箭头光标 ↖
exec --no-startup-id xsetroot -cursor_name left_ptr

# fastcompmgr，比picom更加轻量化
exec --no-startup-id fastcompmgr -o 0 -r 0 -m 1.0

exec --no-startup-id fcitx5

exec --no-startup-id greenclip daemon

exec --no-startup-id lxpolkit

# 每次开机或重启 i3，都先强杀旧的，再启动新的
# exec_always --no-startup-id killall xsettingsd; xsettingsd

# 完美的 xsettingsd 启动与重载方案：延迟1秒避开竞态，清理旧进程，静默拉起新进程
exec_always --no-startup-id sh -c "sleep 1; killall xsettingsd 2>/dev/null; xsettingsd &"


# exec --no-startup-id xsettingsd

# exec_always --no-startup-id picom -b

# 打开上传文件时选取的框
exec --no-startup-id /usr/libexec/xdg-desktop-portal
exec --no-startup-id /usr/libexec/xdg-desktop-portal-gtk

# exec_always --no-startup-id sh -c "sleep 1 && killall -HUP xsettingsd"

# 自动打开numlock
exec_always --no-startup-id numlockx on

# 延迟2秒执行，确保X服务就绪，一次性完美注入NVIDIA所有画面防撕裂与VRR配置
# exec --no-startup-id sh -c "sleep 2 && \
# nvidia-settings --assign 'CurrentMetaMode=nvidia-auto-select +0+0 {ForceCompositionPipeline=On, AllowGSYNCCompatible=On}' && \
# nvidia-settings -a AllowVRR=1 -a ShowVRRVisualIndicator=1"

# 1. NVIDIA 专属配置（只在开机时用 exec 执行一次）
exec --no-startup-id sh -c "sleep 2; nvidia-settings --assign 'CurrentMetaMode=nvidia-auto-select +0+0 {ForceCompositionPipeline=On, AllowGSYNCCompatible=On}'; nvidia-settings -a AllowVRR=1 -a ShowVRRVisualIndicator=1"

# 2. 不让屏幕灭屏配置（用 exec_always，先开启、再清零、后关闭，彻底驯服 NVIDIA）
exec_always --no-startup-id sh -c "sleep 3; xset s off; xset s noblank; xset +dpms; xset dpms 0 0 0; xset -dpms"


# 壁纸
exec_always --no-startup-id feh --bg-fill ~/下载/1.jpg

# xclip是micro与外界互相复制粘贴的纽带。xclip 是一个命令行工具，它的唯一工作就是：把终端里的数据，直接塞进 X11 系统的剪贴板通道；或者反过来，把系统剪贴板里的东西导出来。有时候你发现用 Ctrl+V 粘不出来东西，试着点一下鼠标中键，往往会有奇效。这就是 Linux 桌面奇妙（且偶尔让人抓狂）的底层设计。不需要随i3启动。仅在此记录。

# 开机或重启 i3 时，直接通过 shell 一行流清理并重启 Polybar
exec_always --no-startup-id sh -c "killall -q polybar; while pgrep -x polybar >/dev/null; do sleep 0.1; done; polybar main >/dev/null 2>&1"

title_align center

# 引入主题文件 

include ~/.config/i3/one.conf

workspace_layout default

############## gaps #################

# gaps inner 2
# gaps outer 1
smart_gaps on
smart_borders on

set $mod Mod4

# 1. 强行把全局字体设大（比如 24），以此来把整个标题栏的“盒子”撑高 
# 2. 用 title_format 匹配所有窗口，把文字本身缩回 16，并在两边加空格

font pango: Noto Sans CJK SC 18

for_window [class=".*"] title_format "<span font='Adwaita Sans, Noto Sans CJK SC 16'>  %title  </span>"


exec --no-startup-id dex --autostart --environment i3

# 禁用自动锁屏，方法是把这一行注释掉。
# exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork

exec --no-startup-id nm-applet

floating_modifier $mod
tiling_drag modifier titlebar


[global]
    frame_color = "#61afef"
    separator_color = "#3e4452"
    font = Cantarell Regular, Noto Sans CJK SC 12
    highlight = "#61afef"
    corner_radius = 8
    padding = 10 16
    word_wrap = yes
    max_icon_size = 40
    icon_position = left

[urgency_low]
    background = "#282c34"
    foreground = "#5c6370"
    frame_color = "#3e4452"
    timeout = 5

[urgency_normal]
    background = "#282c34"
    foreground = "#abb2bf"
    frame_color = "#61afef"
    timeout = 10

[urgency_critical]
    background = "#282c34"
    foreground = "#e06c75"
    frame_color = "#e06c75"
    timeout = 0
